{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://watchtower.local/ops-check/rules.schema.json",
  "title": "ops-check rules.yaml",
  "type": "object",
  "required": ["rules"],
  "additionalProperties": true,
  "properties": {
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/rule" }
    }
  },
  "definitions": {
    "stringOrValue": {
      "oneOf": [
        { "type": "string" },
        {
          "type": "object",
          "required": ["value"],
          "additionalProperties": false,
          "properties": {
            "value": { "type": "string" }
          }
        }
      ]
    },
    "duration": {
      "type": "string",
      "pattern": "^\\d+[smh]$"
    },
    "rule": {
      "type": "object",
      "required": ["name", "pattern", "severity"],
      "additionalProperties": true,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "enabled": { "type": "boolean" },
        "description": { "type": "string" },
        "owner": { "type": "string" },
        "since": { "type": "string", "format": "date" },
        "lastReviewedAt": { "type": "string", "format": "date" },
        "pattern": { "type": "string", "minLength": 1 },
        "excludePattern": { "type": "string" },
        "excludePath": {
          "type": "array",
          "items": { "$ref": "#/definitions/stringOrValue" }
        },
        "severity": {
          "type": "string",
          "enum": ["critical", "high", "medium", "low"]
        },
        "autofix": { "type": "boolean" },
        "domain": {
          "type": "string",
          "enum": ["app", "auth", "billing", "secrets", "migrations", "infra", "permissions"]
        },
        "targetRoute": {
          "type": "string",
          "enum": [
            "template_patch",
            "fix_agent_request",
            "issue_only",
            "notify_only",
            "silent"
          ]
        },
        "templateId": { "type": "string" },
        "tags": {
          "type": "array",
          "items": { "$ref": "#/definitions/stringOrValue" }
        },
        "refs": {
          "type": "array",
          "items": { "$ref": "#/definitions/stringOrValue" }
        },
        "minOccurrences": { "type": "integer", "minimum": 1 },
        "window": { "$ref": "#/definitions/duration" },
        "cooldown": { "$ref": "#/definitions/duration" },
        "maxAutofixAttempts": { "type": "integer", "minimum": 1 },
        "fingerprintTemplate": { "type": "string" },
        "stripPatterns": {
          "type": "array",
          "items": { "$ref": "#/definitions/stringOrValue" }
        },
        "examples": {
          "type": "array",
          "items": { "$ref": "#/definitions/stringOrValue" }
        },
        "negativeExamples": {
          "type": "array",
          "items": { "$ref": "#/definitions/stringOrValue" }
        }
      }
    }
  }
}
