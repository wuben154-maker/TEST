# Copy to e2e/.env or e2e/.env.local (recommended for secrets; both are gitignored except this example).
# Loaded by playwright.config.ts after repo root .env — e2e values override root for the same keys.

E2E_EMAIL=
E2E_PASSWORD=

# Optional overrides (defaults match dev stack)
# E2E_API_BASE=http://127.0.0.1:8000
# LOCAL_AUTH_FRONTEND_URL=http://127.0.0.1:8080
