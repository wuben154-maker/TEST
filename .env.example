# Frontend Environment Variables
# Copy to .env and configure

# ============================================
# API MODE: local | cloud
# ============================================
# local: frontend -> local FastAPI (localhost:8000) -> local PostgreSQL
# cloud: frontend -> deployed backend -> Supabase
VITE_API_MODE=local
VITE_LOCAL_API_URL=http://localhost:8000

# Supabase (only when VITE_API_MODE=cloud / backend uses Supabase)
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# Timeline tool `<pre>`: max chars kept client-side (default 2000).
# Align with python SSE_TOOL_RESULT_MAX_BLOCK_CHARS / MAX_SCALAR defaults.
#VITE_SSE_TOOL_RESULT_DISPLAY_MAX_CHARS=2000

# ============================================
# Local browse automation (optional; NOT sent to Vite client)
# Used by: npm run auth:bootstrap (see docs/Process/LOCAL_AUTOMATION_AUTH.md)
# ============================================
# E2E_EMAIL=
# E2E_PASSWORD=
# E2E_API_BASE=http://127.0.0.1:8000
# LOCAL_AUTH_FRONTEND_URL=http://127.0.0.1:8080
