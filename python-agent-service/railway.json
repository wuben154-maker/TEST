{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "python-agent-service/Dockerfile",
    "watchPatterns": ["python-agent-service/**"]
  },
  "deploy": {
    "numReplicas": 1,
    "startCommand": "sh -c \"python -m uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-9090}\"",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 300,
    "startSleepSeconds": 30,
    "sleepApplication": false,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}

