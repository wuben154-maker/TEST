# LangGraph Deep Agent Service Environment Variables
# Copy this file to .env and configure your settings

# ============================================
# AGENT MODE CONFIGURATION
# ============================================
# Runtime is hard-pinned to DeepAgent mode.
AGENT_MODE=deepagent

# ============================================
# DATABASE CONFIGURATION (Local PostgreSQL)
# ============================================
# Set to "local" to use local PostgreSQL (no Supabase needed)
# Set to "supabase" to use Supabase cloud
DATABASE_MODE=local

# Local PostgreSQL settings (used when DATABASE_MODE=local)
# 1. Create DB: createdb -U postgres secmanus
# 2. Init: psql -U postgres -d secmanus -f python-agent-service/scripts/db/init_local_db.sql
# Or run: python-agent-service/scripts/setup_local_db.ps1 (Windows)
LOCAL_DB_HOST=localhost
LOCAL_DB_PORT=54320
LOCAL_DB_NAME=secmanus
LOCAL_DB_USER=postgres
LOCAL_DB_PASSWORD=safedog

# asyncpg pool size (raise max under concurrent /analyze + many API calls)
LOCAL_DB_POOL_MIN_SIZE=2
LOCAL_DB_POOL_MAX_SIZE=30

# SSE progress row throttle (lower DB churn; refresh-after-reload may lag slightly)
PROGRESS_UPSERT_MIN_INTERVAL_SECONDS=0.2
PROGRESS_UPSERT_FORCE_EVERY_N_EVENTS=20

# Supabase settings (used when DATABASE_MODE=supabase only, leave empty for local)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres URI for LangGraph checkpoints only (Dashboard → Settings → Database → URI).
# Must start with postgresql:// or postgres://. Do not put SUPABASE_URL (https://…) here.
# SUPABASE_DB_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# LangGraph checkpointing: postgres needs a valid database_url (local built URL or SUPABASE_DB_URL).
# Use memory for local dev without Postgres checkpoint tables.
# CHECKPOINT_BACKEND=postgres
# ENABLE_CHECKPOINTING=true

# ============================================
# API KEYS (choose one or more)
# ============================================
GOOGLE_API_KEY=your-google-api-key
#OPENAI_API_KEY=your-openai-api-key
DOUBAO_API_KEY=your-doubao-api-key
OPENCODE_ZEN_API_KEY=your-opencode-zen-api-key
#OPENROUTER_API_KEY=your-openrouter-api-key
# Optional OpenRouter attribution headers
#OPENROUTER_APP_URL=https://secmanus.example
#OPENROUTER_APP_TITLE=SecManus Workspace
# OpenRouter unified reasoning (https://openrouter.ai/docs/guides/best-practices/reasoning-tokens)
#OPENROUTER_REASONING_ENABLED=true
#OPENROUTER_REASONING_EFFORT=medium
#KIMI_API_KEY=your-kimi-api-key
#ANTHROPIC_API_KEY=your-anthropic-key
#MINIMAX_API_KEY=
#GLM_API_KEY=
# ============================================
# EXTERNAL API URLS (optional, for custom endpoints)
# ============================================
# AI Provider base URLs (override for custom/proxy endpoints)
# GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# DOUBAO_API_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# KIMI_API_BASE_URL=https://api.moonshot.cn/v1
# GLM_API_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LOVABLE_AI_GATEWAY_URL=https://ai.gateway.lovable.dev/v1
# VirusTotal API
#VIRUSTOTAL_API_KEY=your-virustotal-key
# VIRUSTOTAL_API_BASE_URL=https://www.virustotal.com/api/v3
# VIRUSTOTAL_GUI_BASE_URL=https://www.virustotal.com/gui

# Web search APIs (optional; see python-agent-service/app/tools/research_tools.py)
# Tavily — tried first when set (https://tavily.com)
#TAVILY_API_KEY=
# Serper — Google SERP API, after Tavily, before Crawl4AI scraping (https://serper.dev)
#SERPER_API_KEY=
#SERPER_API_BASE_URL=https://google.serper.dev

# Crawl4AI (web search + URL scraping)
# Local: http://localhost:11235
# Railway: https://your-crawl4ai.up.railway.app
CRAWL4AI_URL=http://localhost:11235
#CRAWL4AI_API_TOKEN=your-token-if-secured
# Optional: HTTP(S) proxy for web_search SERP via Crawl4AI (datacenter egress often sees a different SERP)
#CRAWL4AI_PROXY_SERVER=http://user:pass@host:8888
# Search engine for web_search scraping: google (default) or bing
#WEB_SEARCH_ENGINE=google

# Firecrawl (deprecated - use Crawl4AI)
#FIRECRAWL_API_URL=http://localhost:3002/v1
#FIRECRAWL_API_KEY=fc-local

# ============================================
# LANGSMITH (optional, for observability)
# ============================================
#LANGSMITH_API_KEY=lsv2_your-langsmith-key
#LANGSMITH_PROJECT=security-deep-agent
#LANGSMITH_TRACING=true

# ============================================
# LOGGING PERSISTENCE
# ============================================
# "stdout" (default) = console only (container/cloud collects stdout)
# "file"  = RotatingFileHandler only (bare-metal / local dev)
# "both"  = stdout + file
#LOG_SINK=stdout
#LOG_FILE_PATH=logs/secmanus.log
#LOG_FILE_MAX_BYTES=10485760
#LOG_FILE_BACKUP_COUNT=5

# ============================================
# SERVER CONFIGURATION
# ============================================
# Fallback IANA zone when the client does not send X-Client-Timezone (default UTC)
# APP_TIMEZONE=UTC
HOST=0.0.0.0
PORT=8000
WORKERS=4
RELOAD=true

# Knowledge base (.docx): `{KNOWLEDGE_STORAGE_ROOT or upload_dir}/knowledge/<user_id>/`
# KNOWLEDGE_STORAGE_ROOT=
# KNOWLEDGE_MAX_BYTES_PER_FILE=

# ============================================
# AGENT CONFIGURATION
# ============================================
DEFAULT_MODEL=google/gemini-3-flash-preview
ENABLE_GEMINI_THINKING=True
MAX_ITERATIONS=20
TIMEOUT_SECONDS=300
# Per-LLM-call HTTP read timeout (seconds). Caps idle time between streaming
# chunks. Does NOT limit total duration for long-running extended thinking.
LLM_REQUEST_TIMEOUT_SECONDS=120
# Total wall-clock cap for a single subagent invocation (seconds).
# Prevents extended-thinking models from running indefinitely.
# 0 = no limit (relies on outer session TIMEOUT_SECONDS only).
SUBAGENT_TIMEOUT_SECONDS=300
READ_FILE_DEFAULT_LIMIT=1000

# SSE: generic tool-result humanizer (stdout/content blocks vs inline scalars)
#SSE_TOOL_RESULT_MAX_BLOCK_CHARS=2000
#SSE_TOOL_RESULT_MAX_SCALAR_CHARS=2000

# ============================================
# WEB THREAT LAYERS (detect_web_attack — YARA / entropy / syntax sandbox)
# ============================================
# WEB_THREAT_YARA_ENABLED=true
# WEB_THREAT_YARA_RULES_DIR=
# WEB_THREAT_ENTROPY_ENABLED=true
# WEB_THREAT_SANDBOX_ENABLED=true
# WEB_THREAT_SANDBOX_TIMEOUT_SEC=8

# L4 E2B dynamic escalation — triggered only when L1-L3 are inconclusive.
# Requires E2B_API_KEY to be set.  Off by default.
# WEB_THREAT_E2B_ESCALATION_ENABLED=false
# Confidence threshold: if max_confidence >= this AND severity >= high, L4 is skipped (already definitive).
# WEB_THREAT_E2B_CONFIDENCE_THRESHOLD=0.80

# ============================================
# E2B CLOUD SANDBOX (on-demand isolation)
# https://e2b.dev — required for sandbox_create / sandbox_run / sandbox_pty_run tools
# When unset, sandbox tools are NOT mounted on the agent.
# ============================================
#E2B_API_KEY=e2b_your_api_key_here
# Override the default template declared in config/sandbox.yaml:
#E2B_DEFAULT_TEMPLATE=base

# ============================================
# BINARY ANALYSIS SUBAGENT (subagents/official/binary_analysis)
# Prefix BINARY_ANALYSIS_ — see bundle config.py. E2B_API_KEY is unprefixed (shared with OS env).
# ============================================
# Subprocess sandbox (local / CI). Set true only when bundle E2B backend is enabled for your run.
BINARY_ANALYSIS_USE_E2B=false
# Same flag + E2B_API_KEY select the backend for: bundle api.py / langgraph_entry,
# :func:`sandbox.factory.build_binary_sandbox_client`, and Deep Agent
# ``binary-analysis`` registry tools (`config/subagents.registry.yaml`).
# Subprocess mode runs workers on host tempdirs; workers run in-document processes on host.

# E2B (remote VM sandbox)
# BINARY_ANALYSIS_USE_E2B=true
# E2B_API_KEY=e2b_your_api_key_here
# BINARY_ANALYSIS_E2B_TEMPLATE=binary-analysis-ubuntu-2204
# BINARY_ANALYSIS_E2B_TEMPLATE=binary-analysis-ubuntu-2204-dev

# Sandbox session wall-clock budget (seconds); increase for long document / macro pipelines (default ~330).
# BINARY_ANALYSIS_SANDBOX_TIMEOUT_SECONDS=900

# LangGraph recursion cap for bundle api.py / langgraph_entry (inherits 500 when unset/invalid).
# BINARY_ANALYSIS_RECURSION_LIMIT=500

# Optional — standalone binary_analysis CLI / langgraph dev only (main service model: DEFAULT_MODEL above).
# BINARY_ANALYSIS_GOOGLE_MODEL=gemini-3-flash-preview
# BINARY_ANALYSIS_MODEL=openai:gpt-4o-mini
# BINARY_ANALYSIS_MODEL=anthropic:claude-sonnet-4-5-20250929

# Document analysis tunables (prefix DEEPAGENT_, see bundle DocumentSettings)
# DEEPAGENT_MAX_RECURSION_DEPTH=2
# DEEPAGENT_TOKEN_BUDGET=80000
# DEEPAGENT_MAX_ROUNDS=15
# DEEPAGENT_VBA_SIMULATION_TIMEOUT_SEC=60
# DEEPAGENT_VBA_MAX_INSTRUCTIONS=100000
# DEEPAGENT_PASSWORD_LIST_PATH=/etc/deepagent/container_password_list.yaml

# ============================================
# SOC ALERT TRIAGE (5-node LangGraph, optional overrides)
# ============================================
# Directory for per-run triage logs (default: python-agent-service/logs)
# SOC_TRIAGE_LOG_DIR=
#
# Override stage template directory (default: subagents/official/soc_alert/skills/soc_alert/stages)
# SOC_TRIAGE_STAGES_DIR=
#
# Print per-node stage file metadata and JSON outputs to stderr
# SOC_TRIAGE_VERBOSE=1
#
# SOC alert batch filter discard log directory (default: python-agent-service/logs)
# SOC_ALERT_FILTER_LOG_DIR=
#
# SOC alert profile API tools config
# Default config path: python-agent-service/config/soc_alert_api_services.json
# SOC_ALERT_API_SERVICES_CONFIG_PATH=
# VIRUSTOTAL_API_KEY=
# EDR_MOCK_BASE_URL=http://127.0.0.1:PORT
# TDP_MOCK_BASE_URL=http://127.0.0.1:PORT

STORE_ENCRYPTION_KEY=f1AmqwoXSTBqwlxpu_XObwuwpORmCocLd5oXM_i21KEPVVnEt8Fgsih-Jwla_urv